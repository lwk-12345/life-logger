{
  "segments": [
    {"start": 0.0, "end": 4.0, "text": "记录一下，今天早上八点十分起床了。"},
    {"start": 900.0, "end": 906.0, "text": "早餐吃了两个鸡蛋和一碗粥。"},
    {"start": 1500.0, "end": 1507.0, "text": "花4块9买了一瓶饮料。"},
    {"start": 5400.0, "end": 5406.0, "text": "上午跑步三十分钟。"},
    {"start": 7200.0, "end": 7208.0, "text": "上午和同事沟通了项目方向。"},
    {"start": 9000.0, "end": 9008.0, "text": "我觉得生活日志应该先做音频主链路。"},
    {"start": 10800.0, "end": 10808.0, "text": "明天提醒我把录音文件导出来。"}
